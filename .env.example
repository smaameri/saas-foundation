DATABASE_URL=postgresql://app:password@localhost:5432/app_dev

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

RESEND_API_KEY=
EMAIL_FROM=
# Set false to skip admin and organization invitation emails and share links manually.
# Defaults to true when unset; a missing RESEND_API_KEY also skips sending.
INVITATION_EMAIL_ENABLED=true

# Inngest Cloud credentials (not required for local development).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set INNGEST_DEV=1 on local to use the local Dev Server.
